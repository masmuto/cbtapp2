# =========================================
# CBT Sekolah — .gitignore
# =========================================

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lockb

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log
server.log
*.log

# === ENVIRONMENT & SECRETS ===
# JANGAN PERNAH commit file .env atau file yang berisi rahasia
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# .env.example TIDAK di-ignore (sebagai template)

# === DATABASE ===
# SQLite file lokal (dev only — di produksi gunakan PostgreSQL/Supabase)
db/
*.db
*.db-journal
*.sqlite
*.sqlite3

# === PRISMA ===
# Generated client (akan di-regenerate saat install)
prisma/migrations/dev.db*

# === SANDBOX-SPECIFIC (tidak relevan di Vercel/GitHub) ===
.zscripts/
tests/python-runtime-*.sh
skills/
examples/

# === BUILD ARTIFACTS ===
.vercel
*.tsbuildinfo

# === IDE ===
.vscode/
.idea/
*.swp
*.swo

# === OS ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
