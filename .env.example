# =========================================
# CBT Sekolah — Environment Variables Example
# =========================================
# Salin file ini menjadi `.env` (dev) atau set di Vercel dashboard (produksi).
# JANGAN commit file `.env` yang berisi rahasia ke repository.

# =========================================
# DATABASE (Pilih salah satu)
# =========================================

# --- OPSI 1: SQLite (DEV LOKAL saja — cepat, tanpa setup) ---
DATABASE_URL="file:./db/dev.db"

# --- OPSI 2: Supabase PostgreSQL (PRODUKSI / Vercel) ---
# 1. Buat project di https://supabase.com
# 2. Settings → Database → Connection string → URI
# 3. Salin ke sini (ganti [YOUR-PASSWORD])
# 4. PENTING: edit prisma/schema.prisma → ganti provider ke "postgresql"
#
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Catatan: gunakan "Connection pooling" URL (port 5432/6543) di Supabase
#          untuk performa lebih baik di serverless Vercel.

# =========================================
# NEXTAUTH (Autentikasi)
# =========================================
# Generate secret acak: openssl rand -base64 32
# atau: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="ubah-dengan-string-acak-yang-panjang-dan-aman-minimal-32-karakter"

# Untuk dev lokal: http://localhost:3000
# Untuk Vercel: https://[NAMA-PROYEK].vercel.app (sesuaikan dengan URL Anda)
NEXTAUTH_URL="http://localhost:3000"

# =========================================
# APLIKASI
# =========================================
# Default timezone untuk sekolah baru
APP_DEFAULT_TIMEZONE="Asia/Jakarta"

# =========================================
# OPSIONAL: RATE LIMITING
# =========================================
# Batasi endpoint simpan jawaban per siswa (anti-spam)
RATE_LIMIT_ANSWERS_PER_MIN=60

# =========================================
# OPSIONAL: UPLOAD STORAGE (untuk lampiran soal)
# =========================================
# UPLOAD_DIR="/tmp/uploads"
# UPLOAD_MAX_SIZE_MB=10

# =========================================
# PWA / FRONTEND
# =========================================
NEXT_PUBLIC_APP_NAME="CBT Sekolah"

# =========================================
# CATATAN KEAMANAN UNTUK VERCEL + SUPABASE
# =========================================
# 1. Set SEMUA variabel di atas di Vercel dashboard:
#    Project Settings → Environment Variables
#
# 2. Di Supabase:
#    - Aktifkan "Connection pooling" (pgbouncer) untuk Vercel serverless
#    - Set pool mode = "Transaction" jika ada error connection limit
#    - Atur "Direct connection" sebagai backup
#
# 3. Untuk schema provider PostgreSQL:
#    Edit prisma/schema.prisma:
#      datasource db {
#        provider = "postgresql"  // ubah dari "sqlite"
#        url      = env("DATABASE_URL")
#      }
#
# 4. Setelah deploy pertama, jalankan migration:
#    - Local: prisma migrate deploy (dengan DATABASE_URL Supabase)
#    - Atau: vercel env pull && npx prisma migrate deploy
#
# 5. Rotasi NEXTAUTH_SECRET secara berkala (re-login semua user).
#
# 6. Jangan pernah commit file .env. Hanya .env.example yang boleh di-commit.
